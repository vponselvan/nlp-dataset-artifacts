*.pyc
output/

local*
.DS_Store

# Virtual environment
venv/
env/
.venv/

# Exclude large checkpoint files and training artifacts
trained_model*/checkpoint-*/
trained_model*/runs/
trained_model*/*.pt
trained_model*/*.bin

# Exclude all trained models (too large for git)
# But keep the folder structure with .gitkeep
trained_model_adversarial_*/*
!trained_model_adversarial_*/.gitkeep

# Exclude ELECTRA-base models (too large)
trained_model_electra_base_*/*
!trained_model_electra_base_*/.gitkeep
trained_model_base/*
!trained_model_base/.gitkeep

# Exclude evaluation results directories (keep JSON files only)
eval_results_*/

# Exclude post-processing results (generated outputs)
postprocessing_results/